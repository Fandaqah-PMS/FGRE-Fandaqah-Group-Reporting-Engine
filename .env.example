APP_NAME="Fandaqah Group Reporting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fgre
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- FGRE: reporting mailbox (any IMAP mailbox, see docs/MAILBOX.md) ---
FGRE_INBOX_ENABLED=false
FGRE_INBOX_POLL_MINUTES=5
# password (any IMAP server) | microsoft (Microsoft 365) | google (Google Workspace / Gmail)
FGRE_MAILBOX_AUTH=password
FGRE_MAILBOX_USERNAME=
FGRE_MAILBOX_PASSWORD=
# Optional for microsoft / google (defaults: outlook.office365.com / imap.gmail.com)
FGRE_MAILBOX_HOST=
FGRE_MAILBOX_PORT=993
FGRE_MAILBOX_ENCRYPTION=ssl
FGRE_MAILBOX_FOLDER=INBOX
FGRE_MAILBOX_PROCESSED_FOLDER=FGRE-Processed
# microsoft only
FGRE_MAILBOX_MS_TENANT_ID=
FGRE_MAILBOX_MS_CLIENT_ID=
FGRE_MAILBOX_MS_CLIENT_SECRET=
# google only
FGRE_MAILBOX_GOOGLE_CLIENT_ID=
FGRE_MAILBOX_GOOGLE_CLIENT_SECRET=
FGRE_MAILBOX_GOOGLE_REFRESH_TOKEN=

# --- FGRE: AI extraction (Anthropic) ---
ANTHROPIC_API_KEY=
FGRE_AI_MODEL=claude-opus-5-5
FGRE_AI_EFFORT=high
FGRE_AI_MAX_TOKENS=64000
