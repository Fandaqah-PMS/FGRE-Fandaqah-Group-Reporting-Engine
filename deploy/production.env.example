# =============================================================================
# FGRE (Fandaqah Group Reporting Engine) - production environment
#
# Copy to the server as /var/www/fgre/.env (owner www-data, mode 640) and replace
# every CHANGE_ME. Never commit the filled-in file. Values marked [ASK] come from
# Fandaqah (mail accounts); the rest are chosen by DevOps.
# =============================================================================

APP_NAME="Fandaqah Group Reporting"
APP_ENV=production
# Left empty on purpose: deploy.sh runs `php artisan key:generate` on the first deploy.
# Keep the generated key in your secrets store; changing it logs everyone out.
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs: storage/logs/laravel-YYYY-MM-DD.log, kept 30 days
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (PostgreSQL 16+; setup script installs 18) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fgre
DB_USERNAME=fgre
DB_PASSWORD=CHANGE_ME

# --- Sessions, cache and queue (all in PostgreSQL, no Redis needed) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
# Must be longer than the job timeout (120 s) so a running job is never picked up twice.
DB_QUEUE_RETRY_AFTER=180

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Outgoing email (invitations, password resets, report subscriptions) [ASK] ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="reports@CHANGE_ME.example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- FGRE: reporting mailbox, where the PMSs email their reports [ASK] ---
# See docs/MAILBOX.md. Turn on once the mailbox works: php artisan fgre:mailbox-test
FGRE_INBOX_ENABLED=true
FGRE_INBOX_POLL_MINUTES=5
# password (any IMAP server) | microsoft (Microsoft 365) | google (Google Workspace / Gmail)
FGRE_MAILBOX_AUTH=password
FGRE_MAILBOX_USERNAME=CHANGE_ME
FGRE_MAILBOX_PASSWORD=CHANGE_ME
# Optional for microsoft / google (defaults: outlook.office365.com / imap.gmail.com)
FGRE_MAILBOX_HOST=CHANGE_ME
FGRE_MAILBOX_PORT=993
FGRE_MAILBOX_ENCRYPTION=ssl
FGRE_MAILBOX_VALIDATE_CERT=true
FGRE_MAILBOX_FOLDER=INBOX
FGRE_MAILBOX_PROCESSED_FOLDER=FGRE-Processed
# microsoft only
FGRE_MAILBOX_MS_TENANT_ID=
FGRE_MAILBOX_MS_CLIENT_ID=
FGRE_MAILBOX_MS_CLIENT_SECRET=
# google only
FGRE_MAILBOX_GOOGLE_CLIENT_ID=
FGRE_MAILBOX_GOOGLE_CLIENT_SECRET=
FGRE_MAILBOX_GOOGLE_REFRESH_TOKEN=

# --- FGRE: reading report PDFs (no AI) ---
# xpdf pdftotext (NOT the Poppler one from poppler-utils: it has no -table mode).
# server-setup.sh installs it here.
FGRE_PDFTOTEXT=/usr/local/bin/pdftotext
FGRE_PDFTOTEXT_TIMEOUT=60

# --- FGRE: storage of received report files and email subscriptions ---
FGRE_STORAGE_DISK=local
FGRE_SUBSCRIPTIONS=true
